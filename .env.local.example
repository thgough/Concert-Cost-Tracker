# Copy this file to .env.local and fill in your Supabase project values.
# In Supabase: open the ConcertCosts project → Connect or Settings → API Keys.
# Copy the Project URL and the publishable key (or anon public key if shown instead).
# Never put a service role or secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
